{
    "name": "zaiko-ai/backend",
    "description": "在庫データ分析AIアプリ POC バックエンド (PHP 8.3 + 公式Anthropic SDK)",
    "require": {
        "php": ">=8.3",
        "anthropic-ai/sdk": "^1.6",
        "guzzlehttp/guzzle": "^7.9",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
