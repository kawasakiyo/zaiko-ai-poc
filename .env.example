# ===== Claude API =====
# Anthropic Console (https://console.anthropic.com) の API Keys で発行したキー。
# 課金が発生します。Git にはコミットしないこと（.env は .gitignore 済み）。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== SQL Server =====
# sa（管理者）パスワード。自分で決める。SQL Server の要件:
# 大文字・小文字・数字・記号のうち3種類以上を含む8文字以上。
SA_PASSWORD=SaPassword

# 分析用の読み取り専用ユーザー analysis_reader のパスワード（AdventureWorks のみ読取）。
ANALYSIS_DB_PASSWORD=AnalysisDbPassword

# アプリ用ユーザー app_user のパスワード（AppDb のみ読み書き）。
APP_DB_PASSWORD=AppDbPassword

# ===== アプリDB / 初期管理者 =====
APP_DB_NAME=AppDbName
APP_DB_USER=AppDbUser
# バックエンド起動時にシードされる初期管理者アカウント（ログインに使用）。
APP_ADMIN_USER=AppAdminUser
APP_ADMIN_PASSWORD=AppAdminPassword
# セッション(ログイントークン)の有効期限（秒）。既定 8 時間。
SESSION_TTL_SEC=28800

# ===== レートリミット（IP単位・Redis固定ウィンドウ）=====
# RATE_LIMIT_WINDOW_SEC 秒あたり同一IPから RATE_LIMIT_MAX 回まで許可。
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=3600

# ===== モデル / 実行 =====
# フロントのモデル選択セレクタの初期値。
DEFAULT_MODEL=claude-sonnet-5
# 1回の分析で返す最大行数（上限）。
MAX_ROWS=500
